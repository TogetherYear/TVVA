{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "enables the default permissions",
    "windows": [
        "Application"
    ],
    "permissions": [
        "core:default",

        "http:default",
        "http:allow-fetch",
        "http:allow-fetch-cancel",
        "http:allow-fetch-read-body",
        "http:allow-fetch-send",
        {
            "identifier":"http:default",
            "allow": [
                {"url": "https://**"},
                {"url": "http://**"}
            ]
        }
    ]
}